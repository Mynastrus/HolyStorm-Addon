package-as: Holy_Storm

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .luarc.json
  - _ace3_source
  - ADMINISTRATION_ARCHITECTURE.md
  - ARCHITECTURE.md
  - INGAME_TEST_CHECKLIST.md
  - MODULE_ARCHITECTURE.md
  - PERMISSION_ARCHITECTURE.md
  - PROJECT_CONTEXT.md
  - RELEASES
  - SYNC_ARCHITECTURE.md
  - tools
  - WoW Addon - Holy Storm.code-workspace
  - LIVE/Holy_Storm/.pkgmeta

move-folders:
  Holy_Storm/LIVE/Holy_Storm: Holy_Storm
  Holy_Storm/LIVE/Holy_Storm_Characters: Holy_Storm_Characters
  Holy_Storm/LIVE/Holy_Storm_Equipment: Holy_Storm_Equipment
  Holy_Storm/LIVE/Holy_Storm_Raids: Holy_Storm_Raids
  Holy_Storm/LIVE/Holy_Storm_MythicPlus: Holy_Storm_MythicPlus
  Holy_Storm/LIVE/Holy_Storm_Delves: Holy_Storm_Delves
  Holy_Storm/LIVE/Holy_Storm_Calendar: Holy_Storm_Calendar
  Holy_Storm/LIVE/Holy_Storm_Professions: Holy_Storm_Professions
  Holy_Storm/LIVE/Holy_Storm_Guild: Holy_Storm_Guild
  Holy_Storm/LIVE/Holy_Storm_GuildLog: Holy_Storm_GuildLog
  Holy_Storm/LIVE/Holy_Storm_News: Holy_Storm_News
  Holy_Storm/LIVE/Holy_Storm_Achievements: Holy_Storm_Achievements
  Holy_Storm/LIVE/Holy_Storm_POI: Holy_Storm_POI
  Holy_Storm/LIVE/Holy_Storm_Positions: Holy_Storm_Positions
